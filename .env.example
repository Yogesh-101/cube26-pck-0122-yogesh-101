# PCK Pack Manager — Environment Variables
# Copy to .env and fill in your values. Never commit .env!

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
# Prefer a model with remaining free-tier quota. flash-lite-latest is a good fallback
# when gemini-2.5-flash / gemini-3.8-flash hit daily request limits.
GEMINI_MODEL=gemini-flash-lite-latest

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Durable storage (DB + photos). Keep these on one volume in production.
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/pack_manager.db
DATABASE_URL=sqlite+aiosqlite:///./storage/pack_manager.db
IMAGE_STORAGE_PATH=./storage/images

# Security
SECRET_KEY=change-me-in-production

# Vision — retry budget for transient Gemini failures (503/429/500/504, timeouts)
VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=2
VLM_RETRY_BASE_SECONDS=1.0

# OpenCV quality gate (uploads + live capture). Soft fails → UNCERTAIN, never auto-seal.
# IMAGE_QUALITY_BLUR_THRESHOLD=50
# IMAGE_QUALITY_BRIGHTNESS_MIN=85
# IMAGE_QUALITY_BRIGHTNESS_MAX=245
# IMAGE_QUALITY_CONTRAST_MIN=18
