# PCK Pack Manager — Environment Variables
# Copy to .env and fill in your values. Never commit .env!

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Durable storage (DB + photos). Keep these on one volume in production.
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/pack_manager.db
DATABASE_URL=sqlite+aiosqlite:///./storage/pack_manager.db
IMAGE_STORAGE_PATH=./storage/images

# Security
SECRET_KEY=change-me-in-production

# Vision — retry budget for transient Gemini failures (503/429/500/504, timeouts)
VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=2
VLM_RETRY_BASE_SECONDS=1.0
